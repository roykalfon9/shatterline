# OS
.DS_Store
Thumbs.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# com.unity.test-framework.performance build-hook scratch files
PerformanceTestRunInfo.json
PerformanceTestRunSettings.json

# Packages lock (keep tracked; comment out if you prefer to ignore)
!/Packages/packages-lock.json
.utmp/
*.slnx
